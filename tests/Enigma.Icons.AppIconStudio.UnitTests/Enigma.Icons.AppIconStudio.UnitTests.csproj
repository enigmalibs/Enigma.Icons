<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings are inherited from Directory.Build.props (SPEC §3.2). GenerateDocumentationFile
       is deliberately NOT set: with TreatWarningsAsErrors it would make CS1591 fire on every public
       test class. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are standalone executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No Microsoft.NET.Test.Sdk, xunit.runner.visualstudio or coverlet: the Microsoft.Testing.Platform
       runner comes from global.json (SPEC §12). No Version= — Central Package Management. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia, Avalonia.Skia (through Avalonia.Desktop) and the Enigma.Icons family all arrive
         transitively from the tool. TestAppBuilder needs Avalonia.Skia specifically: the rasterizer
         tests run with UseHeadlessDrawing disabled, which requires a real render backend. -->
    <ProjectReference Include="..\..\tools\Enigma.Icons.AppIconStudio\Enigma.Icons.AppIconStudio.csproj" />
  </ItemGroup>

</Project>
