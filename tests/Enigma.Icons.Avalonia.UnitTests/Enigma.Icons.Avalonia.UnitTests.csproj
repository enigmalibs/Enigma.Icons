<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings are inherited from Directory.Build.props (SPEC §3.2). GenerateDocumentationFile
       is deliberately NOT set: with TreatWarningsAsErrors it would make CS1591 fire on every public
       test class. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are standalone executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No Microsoft.NET.Test.Sdk, xunit.runner.visualstudio or coverlet: the Microsoft.Testing.Platform
       runner comes from global.json (SPEC §12). No Version= — Central Package Management.
       Avalonia.Headless.XUnit is xUnit v3-native (its nuspec depends on xunit.v3.extensibility.core
       3.2.2), so there is no v2/v3 conflict with xunit.v3 — SPEC §3.3. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Enigma.Icons.Avalonia\Enigma.Icons.Avalonia.csproj" />
  </ItemGroup>

</Project>
